{
  "name": "@mailmon.dev/cli",
  "version": "0.0.0",
  "private": false,
  "description": "Mailmon CLI for local development and testing.",
  "bin": {
    "mailmon": "dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "varlock run -- tsx src/index.ts",
    "build": "tsdown",
    "start": "varlock run -- node dist/index.mjs",
    "lint": "oxlint --config ../../.oxlintrc.json --tsconfig ./tsconfig.json .",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --tsconfig ./tsconfig.json --fix .",
    "typecheck": "oxlint --config ../../.oxlintrc.json --tsconfig ./tsconfig.json --type-check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt --config ../../.oxfmtrc.json .",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check ."
  },
  "dependencies": {
    "@effect/cli": "catalog:",
    "@effect/platform-node": "catalog:",
    "@varlock/google-secret-manager-plugin": "catalog:",
    "effect": "catalog:",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@mailmon/config": "workspace:*",
    "@mailmon/core": "workspace:*",
    "@mailmon/db": "workspace:*",
    "@mailmon/gmail": "workspace:*",
    "@mailmon/queue": "workspace:*",
    "tsdown": "^0.21.10"
  }
}
