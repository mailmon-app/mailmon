# @plugin(@varlock/google-secret-manager-plugin)
# @initGsm(projectId="your-gcp-project")

@type=enum("development", "staging", "production")
NODE_ENV=development

@type=enum("local", "gcp")
MAILMON_ASYNC_TRANSPORT_MODE=local

@type=string
HOST=127.0.0.1

@type=number
PORT=3001

@type=string
@sensitive
DATABASE_URL=postgres://mailmon:mailmon@localhost:5432/mailmon

@type=string
MAILMON_GMAIL_OAUTH_CLIENT_ID=your-google-oauth-client-id

@type=string
@sensitive
MAILMON_GMAIL_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

@type=string
@sensitive
MAILMON_GMAIL_REFRESH_TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

@type=string
MAILMON_GMAIL_PUBSUB_TOPIC_NAME=projects/your-gcp-project/topics/gmail-push

# Optional overrides for local mock Gmail/OAuth servers
# MAILMON_GMAIL_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
# MAILMON_GMAIL_API_BASE_URL=https://gmail.googleapis.com/gmail/v1

# GCP mode overrides
# GCP_PROJECT_ID=your-gcp-project
# GCP_REGION=your-gcp-region
# MAILMON_WORKER_BASE_URL=https://your-worker-service.run.app
# MAILMON_GCP_WEBHOOK_DELIVERY_QUEUE_ID=mailmon-webhook-deliveries
# MAILMON_GCP_TASKS_SERVICE_ACCOUNT_EMAIL=tasks@your-gcp-project.iam.gserviceaccount.com
# MAILMON_GCP_TASKS_AUDIENCE=https://your-worker-service.run.app

# Legacy BullMQ fallback
# REDIS_URL=redis://localhost:6379
