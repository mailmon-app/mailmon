{
  "name": "mailmon.dev",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@mailmon/api --filter=@mailmon/worker",
    "openapi:generate": "pnpm --filter @mailmon/api openapi:generate",
    "sdk:check": "pnpm openapi:generate && fern check",
    "sdk:generate": "pnpm openapi:generate && fern generate --group ts-sdk --local --force && node scripts/apply-sdk-customizations.mjs",
    "sdk:generate:release": "node scripts/generate-sdk-for-release.mjs",
    "sdk:generate:remote": "pnpm openapi:generate && fern generate --group ts-sdk && node scripts/apply-sdk-customizations.mjs",
    "build:libs": "turbo run build --filter=@mailmon/core --filter=@mailmon/config --filter=@mailmon/gmail --filter=@mailmon/db --filter=@mailmon/queue",
    "build-packages": "pnpm build:libs && pnpm sdk:generate:release && pnpm --filter @mailmon.dev/cli build",
    "release": "pnpm build-packages && changeset publish",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "turbo run test:watch",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "db:generate": "turbo run db:generate --filter=@mailmon/db",
    "db:migrate": "turbo run db:migrate --filter=@mailmon/db",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "effect-solutions:list": "effect-solutions list",
    "effect-solutions:show": "effect-solutions show",
    "lint-staged": "lint-staged",
    "prepare": "effect-language-service patch && husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@effect/language-service": "catalog:",
    "@effect/vitest": "4.0.0-beta.65",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.6",
    "effect": "catalog:",
    "effect-solutions": "^0.5.3",
    "fern-api": "^5.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsx": "^4.21.0",
    "turbo": "^2.9.12",
    "typescript": "catalog:",
    "vitest": "^4.1.6"
  },
  "lint-staged": {
    "*.{json,md,yaml,yml}": "oxfmt --config ./.oxfmtrc.json --write --no-error-on-unmatched-pattern",
    "apps/api/**/*.{ts,tsx}": "oxlint --config ./.oxlintrc.json --tsconfig ./apps/api/tsconfig.json --fix",
    "apps/worker/**/*.{ts,tsx}": "oxlint --config ./.oxlintrc.json --tsconfig ./apps/worker/tsconfig.json --fix",
    "apps/cli/**/*.{ts,tsx}": "oxlint --config ./.oxlintrc.json --tsconfig ./apps/cli/tsconfig.json --fix",
    "packages/core/**/*.{ts,tsx}": "oxlint --config ./.oxlintrc.json --tsconfig ./packages/core/tsconfig.json --fix",
    "packages/config/**/*.{ts,tsx}": "oxlint --config ./.oxlintrc.json --tsconfig ./packages/config/tsconfig.json --fix",
    "packages/db/**/*.{ts,tsx}": "oxlint --config ./.oxlintrc.json --tsconfig ./packages/db/tsconfig.json --fix",
    "packages/gmail/**/*.{ts,tsx}": "oxlint --config ./.oxlintrc.json --tsconfig ./packages/gmail/tsconfig.json --fix",
    "packages/queue/**/*.{ts,tsx}": "oxlint --config ./.oxlintrc.json --tsconfig ./packages/queue/tsconfig.json --fix"
  },
  "packageManager": "pnpm@10.32.1"
}
